# Copy this file to .env at the repository root.
# .env is gitignored. Do not commit API keys.

# Required. Setup stores this in the project Hermes profile, not in git.
OPENAI_API_KEY=

# development | test | production
NODE_ENV=development

# HTTP port for the NestJS API.
PORT=3000

# SQLite database URL. Relative paths are resolved from apps/api,
# so this file is created at apps/api/data/dev.db.
DATABASE_URL="file:./data/dev.db"

# Browser origin allowed to call the API during local development.
WEB_ORIGIN=http://localhost:5173

# Optional absolute path to the Hermes executable. When unset, the API resolves `hermes` from PATH.
# HERMES_EXECUTABLE=/Users/example/.local/bin/hermes

# Optional frontend override. The Vue app already defaults to this URL.
# Put it in apps/web/.env.local only if the API is not on localhost:3000.
# Do not put the database URL or any secret in a VITE_ variable.
# VITE_API_BASE_URL=http://localhost:3000/api/v1
